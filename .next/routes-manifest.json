{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ],
      "regex": "^(?:/(.*))(?:/)?$"
    }
  ],
  "dynamicRoutes": [
    {
      "page": "/analysis/[id]",
      "regex": "^/analysis/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/analysis/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/admin/users/[id]",
      "regex": "^/api/admin/users/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/admin/users/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/analysis/[id]",
      "regex": "^/api/analysis/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/analysis/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/auth/[...nextauth]",
      "regex": "^/api/auth/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPnextauth": "nxtPnextauth"
      },
      "namedRegex": "^/api/auth/(?<nxtPnextauth>.+?)(?:/)?$"
    },
    {
      "page": "/api/tenders/[id]",
      "regex": "^/api/tenders/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/tenders/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/tenders/[id]/assign-owner",
      "regex": "^/api/tenders/([^/]+?)/assign\\-owner(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/tenders/(?<nxtPid>[^/]+?)/assign\\-owner(?:/)?$"
    },
    {
      "page": "/api/tenders/[id]/bid-status",
      "regex": "^/api/tenders/([^/]+?)/bid\\-status(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/tenders/(?<nxtPid>[^/]+?)/bid\\-status(?:/)?$"
    },
    {
      "page": "/api/tenders/[id]/diagnose-docs",
      "regex": "^/api/tenders/([^/]+?)/diagnose\\-docs(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/tenders/(?<nxtPid>[^/]+?)/diagnose\\-docs(?:/)?$"
    },
    {
      "page": "/api/tenders/[id]/documents",
      "regex": "^/api/tenders/([^/]+?)/documents(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/tenders/(?<nxtPid>[^/]+?)/documents(?:/)?$"
    },
    {
      "page": "/api/tenders/[id]/documents/[docId]/download",
      "regex": "^/api/tenders/([^/]+?)/documents/([^/]+?)/download(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid",
        "nxtPdocId": "nxtPdocId"
      },
      "namedRegex": "^/api/tenders/(?<nxtPid>[^/]+?)/documents/(?<nxtPdocId>[^/]+?)/download(?:/)?$"
    },
    {
      "page": "/api/tenders/[id]/fetch-documents",
      "regex": "^/api/tenders/([^/]+?)/fetch\\-documents(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/tenders/(?<nxtPid>[^/]+?)/fetch\\-documents(?:/)?$"
    },
    {
      "page": "/api/tenders/[id]/fetch-overview",
      "regex": "^/api/tenders/([^/]+?)/fetch\\-overview(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/tenders/(?<nxtPid>[^/]+?)/fetch\\-overview(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/admin",
      "regex": "^/admin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin(?:/)?$"
    },
    {
      "page": "/analysis",
      "regex": "^/analysis(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/analysis(?:/)?$"
    },
    {
      "page": "/dashboard",
      "regex": "^/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/login/microsoft",
      "regex": "^/login/microsoft(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login/microsoft(?:/)?$"
    },
    {
      "page": "/logout",
      "regex": "^/logout(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/logout(?:/)?$"
    },
    {
      "page": "/my-tenders",
      "regex": "^/my\\-tenders(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/my\\-tenders(?:/)?$"
    },
    {
      "page": "/scrape-runs",
      "regex": "^/scrape\\-runs(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/scrape\\-runs(?:/)?$"
    },
    {
      "page": "/settings",
      "regex": "^/settings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/settings(?:/)?$"
    },
    {
      "page": "/tenders",
      "regex": "^/tenders(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/tenders(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "RSC",
    "varyHeader": "RSC, Next-Router-State-Tree, Next-Router-Prefetch, Next-Router-Segment-Prefetch",
    "prefetchHeader": "Next-Router-Prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "Next-Router-Segment-Prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  },
  "rewrites": []
}